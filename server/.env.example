# Sunucu portu
PORT=4000

# Yönetim paneli giriş şifresi
ADMIN_PASSWORD=degistir-beni

# Oturum token'ı ve ikas Client Secret şifrelemesi için uzun rastgele bir değer.
# Örnek üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DİKKAT: Bu değer değişirse kayıtlı Client Secret'lar çözülemez, yeniden girilmesi gerekir.
APP_SECRET=

# SQLite veritabanı dosyası (Railway'de kalıcı volume yoluna verin, örn. /data/most-seller.db)
DB_PATH=./data/most-seller.db

# Widget'ın ve panelin çağıracağı genel adres (kurulum kodunda kullanılır)
PUBLIC_URL=http://localhost:4000

# Zamanlayıcının kaç dakikada bir senkron gereken mağazaları kontrol edeceği
SCHEDULER_TICK_MINUTES=10
